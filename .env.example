# Croma — completar tras obtener API key en platform.usecroma.com
CROMA_API_KEY=
# Base URL sin valor por defecto a propósito: no asumimos la URL real hasta verla en la plataforma
CROMA_BASE_URL=

# Cuentas. Sin esta variable se usa SQLite local (dev): sirve para desarrollar,
# pero en un contenedor efímero (Render free) las cuentas se pierden en cada
# redeploy y en cada arranque tras el spin-down. Producción = Postgres.
# Se pega tal cual el connection string de Neon/Render; el código lo traduce
# al driver async y mueve sslmode a la conexión.
# DATABASE_URL=postgresql://usuario:clave@host.neon.tech/traza?sslmode=require

# LLM (Pista B)
LLM_PROVIDER=openai
# ID verificado contra developers.openai.com el 14-ago-2026; el alias "gpt-5.6" enruta a Sol, NO usarlo
LLM_MODEL=gpt-5.6-terra
OPENAI_API_KEY=
